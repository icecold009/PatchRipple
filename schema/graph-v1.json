{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "change",
    "changes",
    "nodes",
    "edges",
    "warnings",
    "completeness",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseTipSha",
        "analysisBaseSha",
        "headSha",
        "mode"
      ],
      "properties": {
        "baseTipSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "analysisBaseSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "headSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "mode": {
          "enum": [
            "pr",
            "direct"
          ]
        },
        "pullRequest": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "A",
              "M",
              "D",
              "R",
              "T"
            ]
          },
          "oldPath": {
            "type": "string"
          },
          "newPath": {
            "type": "string"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "roles",
          "revisions",
          "owners",
          "testReasons"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "changed",
                "impact",
                "test"
              ]
            }
          },
          "revisions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "base",
                "head"
              ]
            }
          },
          "owners": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "testReasons": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "kind",
          "revision"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "revision": {
            "enum": [
              "base",
              "head"
            ]
          },
          "kind": {
            "enum": [
              "static",
              "type-only",
              "dynamic-literal",
              "require",
              "python"
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "revision": {
            "enum": [
              "base",
              "head"
            ]
          }
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "omittedNodes",
        "omittedEdges"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "omittedNodes": {
          "type": "integer",
          "minimum": 0
        },
        "omittedEdges": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxFiles",
        "maxBytes",
        "maxFileBytes",
        "maxNodes",
        "maxEdges",
        "maxDepth",
        "timeoutMs"
      ],
      "properties": {
        "maxFiles": {
          "type": "integer",
          "minimum": 1
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxFileBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 1
        },
        "maxEdges": {
          "type": "integer",
          "minimum": 1
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
